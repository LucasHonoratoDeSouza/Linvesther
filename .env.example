# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# A read-only Binance API key (Account -> API Management -> Create API,
# enable ONLY "Enable Reading" — leave every trade/withdraw/transfer
# permission off). Used by services/collector/binance/live-client's
# homologation tests and, indirectly, by apps/api's
# POST /accounts/:accountId/binance-connection route when calling the
# real binance-worker binary.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Postgres connection string for services/collector/binance/worker and
# apps/api (infra/docker-compose.yml's postgres service listens on host
# port 5433, not 5432). Required for sign-ins, identities and published
# claims to survive an API restart; without it they are kept in memory.
DATABASE_URL=postgresql://linvestherzk:linvestherzk-local-dev-only@localhost:5433/linvestherzk

# Encrypts stored Binance credentials at rest (AES-256-GCM). Generate
# with: openssl rand -hex 32
# See services/collector/binance/worker/README.md for the documented
# limitation (a single symmetric key, not a real KMS) this covers.
BINANCE_WORKER_ENCRYPTION_KEY=
# Old key(s) still needed to read stored credentials while rotating
# (comma-separated hex). Run `rekey` on the worker, then remove this.
BINANCE_WORKER_ENCRYPTION_KEY_PREVIOUS=

# On-chain identity. All the addresses below must be set for apps/api
# to register /identities* — omitted,
# those routes are simply not registered, not a crash. CHAIN_RPC_URL
# defaults to Base Sepolia's public RPC (no signup/key needed) once a
# real deployment exists; for local dev, point it at a local Anvil
# instance instead. CHAIN_RELAYER_PRIVATE_KEY only ever needs to hold
# gas — it authorizes nothing about a user's identity by itself (see
# services/chain-worker/src/identity/relayFlow.ts's own doc comment).
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_RELAYER_PRIVATE_KEY=
IDENTITY_REGISTRY_ADDRESS=
ACCOUNT_REGISTRY_ADDRESS=
ACCOUNT_FACTORY_ADDRESS=
PROFILE_REGISTRY_ADDRESS=

# The block the contracts above were deployed at (see the matching
# contracts/deployments/<network>.json's "deployBlock") — the
# indexer's very first sync after a process restart starts here, never
# scanning from genesis on a real, long-lived chain. Defaults to 0,
# correct only for a fresh local Anvil chain.
CHAIN_DEPLOY_BLOCK=0

# The collector's signing key: every proof records which key signed the source
# data. Generate with: openssl rand -hex 32. An instance that signs with its own
# key produces self-attested proofs unless a verifier chooses to trust that key
# (see trust/collectors.json).
BINANCE_WORKER_A0_SIGNING_KEY=

# Number of reverse proxies in front of the API (1 behind a tunnel or a single
# load balancer). Rate limits are per client address; without this every client
# looks like the proxy. Leave unset when the API is reached directly.
# TRUST_PROXY_HOPS=1

# Secrets can also be given as files instead of variables, which keeps them out
# of the process environment (`/proc/<pid>/environ`, `docker inspect`). Set
# NAME_FILE=/path (mode 600) for BINANCE_WORKER_ENCRYPTION_KEY or
# BINANCE_WORKER_A0_SIGNING_KEY; the file wins over the variable.
# BINANCE_WORKER_ENCRYPTION_KEY_FILE=
# BINANCE_WORKER_A0_SIGNING_KEY_FILE=

# Most gas-paying actions (identity creation and similar) the operator funds per
# hour, across all clients together. Default 300.
# RELAY_MAX_PER_HOUR=300

# The database password used by infra/docker-compose.yml. The built-in default is
# public: set your own for anything that holds real data.
# POSTGRES_PASSWORD=

# The relayer refuses to broadcast when its balance is below this many wei, and
# the API answers 503 relayer_underfunded instead of failing mid-transaction.
# Default 1000000000000 (0.000001 ETH); 0 disables the floor.
# RELAYER_MIN_BALANCE_WEI=1000000000000

# Scales every per-client traffic limit. For a test environment that signs in
# far faster than a person; leave unset in production.
# TRAFFIC_LIMIT_MULTIPLIER=
