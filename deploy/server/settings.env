# Non-secret settings for the production services. Secrets live in
# ~/linvesther/shared/.env (mode 600), which is never versioned.
ROOT_DOMAIN=linvesther.com
NEXT_PUBLIC_API_URL=https://api.linvesther.com
NEXT_PUBLIC_DOCS_URL=https://docs.linvesther.com
WEBAUTHN_ORIGIN=https://app.linvesther.com
WEBAUTHN_RP_ID=linvesther.com
CORS_ORIGINS=https://linvesther.com,https://app.linvesther.com,https://docs.linvesther.com
# One proxy (the Cloudflare tunnel) sits in front of the API.
TRUST_PROXY_HOPS=1
# The MCP server sits behind the same tunnel, reached at this hostname.
MCP_ALLOWED_HOSTS=mcp.linvesther.com,localhost,127.0.0.1,::1
